# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and local tool state
/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/
/.claude/settings*.json
.phpactor.json

# Environment and credentials
.env
.zfy-release.json
.env.*
!.env.example
/auth.json
/storage/*.key

# PHP dependencies and local installers
/vendor/
/composer-setup.php
/composer.phar

# Node dependencies, package-manager caches and logs
/node_modules/
/.npm/
/.pnpm-store/
/.yarn/*
!/.yarn/releases/
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/sdks/
!/.yarn/versions/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Laravel runtime caches
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
/.phpunit.cache/
.phpunit.result.cache

# Databases and local development services
/database/*.sqlite
/database/*.sqlite-*
Homestead.json
Homestead.yaml

# Frontend build output
/public/build/
/public/hot
/public/storage

# Application runtime storage
/storage/app/*
!/storage/app/.gitignore
!/storage/app/private/
!/storage/app/private/.gitignore
!/storage/app/public/
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/debugbar/
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail/

# Test and coverage output
/coverage/
/dist/
/.nyc_output/

# Temporary files
/tmp/
*.log
