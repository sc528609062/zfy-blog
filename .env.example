APP_NAME=zfy-blog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
ZFY_INSTALLED=false

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zfy_blog
DB_USERNAME=zfy_blog
DB_PASSWORD=zfy_blog

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@zfy-blog.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SCOUT_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

ZFY_DEFAULT_THEME=style-a-blue-gaming
ZFY_NETEASE_PROXY_STREAM=true
ZFY_NETEASE_BITRATE=320000
# 如果歌单包含网易云未登录不可播放的歌曲，在服务器环境配置自己的网易云 Cookie，例如 MUSIC_U=...
ZFY_NETEASE_COOKIE=

# 支付密钥只放服务器环境或后台加密配置，不提交真实生产密钥。
PAY_ALIPAY_APP_ID=sandbox-placeholder
PAY_ALIPAY_PRIVATE_KEY=sandbox-placeholder
PAY_ALIPAY_PUBLIC_KEY=sandbox-placeholder
PAY_WECHAT_MCH_ID=sandbox-placeholder
PAY_WECHAT_KEY=sandbox-placeholder
PAY_WECHAT_CERT_PATH=
PAY_HUPIJIAO_APPID=sandbox-placeholder
PAY_HUPIJIAO_SECRET=sandbox-placeholder
PAY_EPAY_PID=sandbox-placeholder
PAY_EPAY_KEY=sandbox-placeholder
PAY_EPAY_ENDPOINT=https://example.com

VITE_APP_NAME="${APP_NAME}"
