APP_NAME=zfy-blog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
ZFY_INSTALLED=false

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zfy_blog
DB_USERNAME=zfy_blog
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@zfy-blog.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SCOUT_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

ZFY_DEFAULT_THEME=style-a-blue-gaming
ZFY_NETEASE_PROXY_STREAM=true
ZFY_NETEASE_BITRATE=320000
# 如果歌单包含网易云未登录不可播放的歌曲，在服务器环境配置自己的网易云 Cookie，例如 MUSIC_U=...
ZFY_NETEASE_COOKIE=

# 支付配置为空时渠道不可用；真实凭据仅配置在服务器。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_APP_CERT=
ALIPAY_PUBLIC_CERT=
ALIPAY_ROOT_CERT=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_MCH_CERT=
WECHAT_APP_ID=
WECHAT_PLATFORM_SERIAL=
WECHAT_PLATFORM_CERT=
HUPIJIAO_APP_ID=
HUPIJIAO_APP_SECRET=
EPAY_URL=
EPAY_PID=
EPAY_KEY=

ZFY_UPDATE_PROVIDER=gitee
ZFY_UPDATE_REPOSITORY=c528609062/zfy-blog
ZFY_UPDATE_PUBLIC_KEY=
ZFY_UPDATE_TOKEN=
ZFY_SAFE_MODE=false
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_REGION=
COS_APP_ID=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=

VITE_APP_NAME="${APP_NAME}"
