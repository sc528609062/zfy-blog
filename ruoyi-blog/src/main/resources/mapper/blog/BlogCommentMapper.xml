<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.blog.mapper.BlogCommentMapper">

    <resultMap type="BlogComment" id="BlogCommentResult">
        <result property="commentId" column="comment_id"/>
        <result property="articleId" column="article_id"/>
        <result property="articleTitle" column="article_title"/>
        <result property="parentId" column="parent_id"/>
        <result property="commentContent" column="comment_content"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="userEmail" column="user_email"/>
        <result property="userAvatar" column="user_avatar"/>
        <result property="likeCount" column="like_count"/>
        <result property="status" column="status"/>
        <result property="ipAddress" column="ip_address"/>
        <result property="createTime" column="create_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectBlogCommentVo">
        select c.comment_id,
               c.article_id,
               c.parent_id,
               c.comment_content,
               c.user_id,
               c.user_name,
               c.user_email,
               c.user_avatar,
               c.like_count,
               c.status,
               c.ip_address,
               c.create_time,
               c.del_flag,
               a.article_title
        from blog_comment c
        left join blog_article a on a.article_id = c.article_id
    </sql>

    <select id="selectBlogCommentList" parameterType="BlogComment" resultMap="BlogCommentResult">
        <include refid="selectBlogCommentVo"/>
        <where>
            c.del_flag = '0'
            <if test="userName != null and userName != ''">
                and c.user_name like concat('%', #{userName}, '%')
            </if>
            <if test="status != null and status != ''">
                and c.status = #{status}
            </if>
            <if test="articleTitle != null and articleTitle != ''">
                and a.article_title like concat('%', #{articleTitle}, '%')
            </if>
            <if test="articleId != null">
                and c.article_id = #{articleId}
            </if>
        </where>
        order by c.create_time desc
    </select>

    <select id="selectApprovedCommentListByArticleId" parameterType="Long" resultMap="BlogCommentResult">
        <include refid="selectBlogCommentVo"/>
        where c.article_id = #{articleId}
          and c.status = '1'
          and c.del_flag = '0'
        order by c.create_time asc
    </select>

    <select id="selectBlogCommentByCommentId" parameterType="Long" resultMap="BlogCommentResult">
        <include refid="selectBlogCommentVo"/>
        where c.comment_id = #{commentId}
          and c.del_flag = '0'
    </select>

    <insert id="insertBlogComment" parameterType="BlogComment" useGeneratedKeys="true" keyProperty="commentId">
        insert into blog_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="articleId != null">article_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="commentContent != null and commentContent != ''">comment_content,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="userEmail != null and userEmail != ''">user_email,</if>
            <if test="userAvatar != null and userAvatar != ''">user_avatar,</if>
            <if test="likeCount != null">like_count,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="ipAddress != null and ipAddress != ''">ip_address,</if>
            create_time,
            del_flag
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="articleId != null">#{articleId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="commentContent != null and commentContent != ''">#{commentContent},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="userEmail != null and userEmail != ''">#{userEmail},</if>
            <if test="userAvatar != null and userAvatar != ''">#{userAvatar},</if>
            <if test="likeCount != null">#{likeCount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="ipAddress != null and ipAddress != ''">#{ipAddress},</if>
            sysdate(),
            '0'
        </trim>
    </insert>

    <update id="updateBlogComment" parameterType="BlogComment">
        update blog_comment
        <trim prefix="set" suffixOverrides=",">
            <if test="articleId != null">article_id = #{articleId},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="commentContent != null and commentContent != ''">comment_content = #{commentContent},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="userEmail != null and userEmail != ''">user_email = #{userEmail},</if>
            <if test="userAvatar != null and userAvatar != ''">user_avatar = #{userAvatar},</if>
            <if test="likeCount != null">like_count = #{likeCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="ipAddress != null and ipAddress != ''">ip_address = #{ipAddress},</if>
        </trim>
        where comment_id = #{commentId}
          and del_flag = '0'
    </update>

    <update id="updateBlogCommentStatus" parameterType="BlogComment">
        update blog_comment
        set status = #{status}
        where comment_id = #{commentId}
          and del_flag = '0'
    </update>

    <delete id="deleteBlogCommentByCommentIds" parameterType="Long">
        update blog_comment
        set del_flag = '2'
        where comment_id in
        <foreach item="commentId" collection="array" open="(" separator="," close=")">
            #{commentId}
        </foreach>
    </delete>

    <delete id="deleteBlogCommentByCommentId" parameterType="Long">
        update blog_comment
        set del_flag = '2'
        where comment_id = #{commentId}
    </delete>

    <select id="selectArticleIdByCommentId" parameterType="Long" resultType="Long">
        select article_id
        from blog_comment
        where comment_id = #{commentId}
        limit 1
    </select>

    <select id="selectArticleIdsByCommentIds" resultType="Long">
        select distinct article_id
        from blog_comment
        where comment_id in
        <foreach item="commentId" collection="commentIds" open="(" separator="," close=")">
            #{commentId}
        </foreach>
    </select>

    <update id="refreshArticleCommentCount" parameterType="Long">
        update blog_article a
        set a.comment_count = (
            select count(1)
            from blog_comment c
            where c.article_id = a.article_id
              and c.status = '1'
              and c.del_flag = '0'
        )
        where a.article_id = #{articleId}
    </update>

</mapper>
