<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.blog.mapper.BlogPageMapper">

    <resultMap type="BlogPage" id="BlogPageResult">
        <result property="pageId" column="page_id"/>
        <result property="pageTitle" column="page_title"/>
        <result property="pageSlug" column="page_slug"/>
        <result property="pageContent" column="page_content"/>
        <result property="pageCover" column="page_cover"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="showInMenu" column="show_in_menu"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectBlogPageVo">
        select page_id,
               page_title,
               page_slug,
               page_content,
               page_cover,
               sort_order,
               show_in_menu,
               status,
               create_by,
               create_time,
               update_by,
               update_time,
               del_flag
        from blog_page
    </sql>

    <select id="selectBlogPageList" parameterType="BlogPage" resultMap="BlogPageResult">
        <include refid="selectBlogPageVo"/>
        <where>
            del_flag = '0'
            <if test="pageTitle != null and pageTitle != ''">
                and page_title like concat('%', #{pageTitle}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="showInMenu != null and showInMenu != ''">
                and show_in_menu = #{showInMenu}
            </if>
        </where>
        order by sort_order asc, update_time desc, create_time desc
    </select>

    <select id="selectBlogPageByPageId" parameterType="Long" resultMap="BlogPageResult">
        <include refid="selectBlogPageVo"/>
        where page_id = #{pageId}
          and del_flag = '0'
    </select>

    <insert id="insertBlogPage" parameterType="BlogPage" useGeneratedKeys="true" keyProperty="pageId">
        insert into blog_page
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pageTitle != null and pageTitle != ''">page_title,</if>
            <if test="pageSlug != null and pageSlug != ''">page_slug,</if>
            <if test="pageContent != null and pageContent != ''">page_content,</if>
            <if test="pageCover != null and pageCover != ''">page_cover,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="showInMenu != null and showInMenu != ''">show_in_menu,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            del_flag
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pageTitle != null and pageTitle != ''">#{pageTitle},</if>
            <if test="pageSlug != null and pageSlug != ''">#{pageSlug},</if>
            <if test="pageContent != null and pageContent != ''">#{pageContent},</if>
            <if test="pageCover != null and pageCover != ''">#{pageCover},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="showInMenu != null and showInMenu != ''">#{showInMenu},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            '0'
        </trim>
    </insert>

    <update id="updateBlogPage" parameterType="BlogPage">
        update blog_page
        <trim prefix="set" suffixOverrides=",">
            <if test="pageTitle != null and pageTitle != ''">page_title = #{pageTitle},</if>
            <if test="pageSlug != null and pageSlug != ''">page_slug = #{pageSlug},</if>
            <if test="pageContent != null and pageContent != ''">page_content = #{pageContent},</if>
            <if test="pageCover != null and pageCover != ''">page_cover = #{pageCover},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="showInMenu != null and showInMenu != ''">show_in_menu = #{showInMenu},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where page_id = #{pageId}
          and del_flag = '0'
    </update>

    <delete id="deleteBlogPageByPageId" parameterType="Long">
        update blog_page
        set del_flag = '2'
        where page_id = #{pageId}
    </delete>

    <delete id="deleteBlogPageByPageIds" parameterType="Long">
        update blog_page
        set del_flag = '2'
        where page_id in
        <foreach item="pageId" collection="array" open="(" separator="," close=")">
            #{pageId}
        </foreach>
    </delete>

</mapper>
