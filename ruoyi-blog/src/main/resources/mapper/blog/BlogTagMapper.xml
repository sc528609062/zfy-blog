<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.blog.mapper.BlogTagMapper">

    <resultMap type="BlogTag" id="BlogTagResult">
        <result property="tagId"    column="tag_id"    />
        <result property="tagName"    column="tag_name"    />
        <result property="tagDesc"    column="tag_desc"    />
        <result property="articleCount"    column="article_count"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectBlogTagVo">
        select tag_id, tag_name, tag_desc, article_count, status, create_by, create_time, update_by, update_time, del_flag from blog_tag
    </sql>

    <select id="selectBlogTagList" parameterType="BlogTag" resultMap="BlogTagResult">
        <include refid="selectBlogTagVo"/>
        <where>
            del_flag = '0'
            <if test="tagName != null and tagName != ''">
                AND tag_name like concat('%', #{tagName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND date_format(create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND date_format(create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
            </if>
        </where>
        order by tag_id desc
    </select>

    <select id="selectBlogTagByTagId" parameterType="Long" resultMap="BlogTagResult">
        <include refid="selectBlogTagVo"/>
        where tag_id = #{tagId} and del_flag = '0'
    </select>

    <insert id="insertBlogTag" parameterType="BlogTag" useGeneratedKeys="true" keyProperty="tagId">
        insert into blog_tag
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tagName != null and tagName != ''">tag_name,</if>
            <if test="tagDesc != null">tag_desc,</if>
            <if test="articleCount != null">article_count,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            del_flag
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tagName != null and tagName != ''">#{tagName},</if>
            <if test="tagDesc != null">#{tagDesc},</if>
            <if test="articleCount != null">#{articleCount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            '0'
        </trim>
    </insert>

    <update id="updateBlogTag" parameterType="BlogTag">
        update blog_tag
        <trim prefix="SET" suffixOverrides=",">
            <if test="tagName != null and tagName != ''">tag_name = #{tagName},</if>
            <if test="tagDesc != null">tag_desc = #{tagDesc},</if>
            <if test="articleCount != null">article_count = #{articleCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where tag_id = #{tagId}
    </update>

    <delete id="deleteBlogTagByTagId" parameterType="Long">
        update blog_tag set del_flag = '2' where tag_id = #{tagId}
    </delete>

    <delete id="deleteBlogTagByTagIds" parameterType="Long">
        update blog_tag set del_flag = '2' where tag_id in
        <foreach item="tagId" collection="array" open="(" separator="," close=")">
            #{tagId}
        </foreach>
    </delete>

    <!-- 更新单个标签的文章数量 -->
    <update id="updateTagArticleCount" parameterType="Long">
        update blog_tag
        set article_count = (
            select count(*) from blog_article_tag at
            inner join blog_article a on at.article_id = a.article_id
            where at.tag_id = #{tagId}
            and a.del_flag = '0'
            and a.article_status = '1'
        )
        where tag_id = #{tagId}
    </update>

    <!-- 批量更新所有标签的文章数量 -->
    <update id="updateAllTagArticleCount">
        update blog_tag t
        left join (
            select at.tag_id, count(*) as count
            from blog_article_tag at
            inner join blog_article a on at.article_id = a.article_id
            where a.del_flag = '0' and a.article_status = '1'
            group by at.tag_id
        ) a on t.tag_id = a.tag_id
        set t.article_count = ifnull(a.count, 0)
        where t.del_flag = '0'
    </update>

</mapper>
