{
    "name": "Default Blue",
    "slug": "default-blue",
    "version": "1.0.0",
    "author": "zfy-blog",
    "description": "A 蓝白游戏资源社区风默认主题，蓝色主色 + 深色英雄区 + 白色卡片，对应 home-a 系列 UI mockup。",
    "compatible": "^3.0",
    "entry": "views/layouts/app.blade.php",
    "preview": "preview.png",
    "menus": ["primary", "mobile", "footer"],
    "regions": ["home", "sidebar", "footer", "content-bottom"],
    "settings_schema": {
        "primary_color": {
            "type": "color",
            "label": "主色",
            "default": "#2563eb"
        },
        "hero_image": {
            "type": "image",
            "label": "首页英雄区背景图",
            "default": null
        },
        "show_visitor_widget": {
            "type": "boolean",
            "label": "显示最近访客",
            "default": true
        },
        "show_rank_widget": {
            "type": "boolean",
            "label": "显示文章排行榜",
            "default": true
        },
        "show_vip_widget": {
            "type": "boolean",
            "label": "显示 VIP 卡片",
            "default": true
        }
    }
}
